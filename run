#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
	echo "Usage: ./run {debug|simulator|iphone|mobileweb|mobileweb-debug}" >&2
	echo "  debug      Manual/Apifox Relay on port 18765" >&2
	echo "  simulator  iPhone Simulator Relay on port 18767" >&2
	echo "  iphone     Physical iPhone Relay on port 18768" >&2
	echo "  mobileweb  Mobile Web Runtime Relay on port 18775" >&2
	echo "  mobileweb-debug  Local Mobile Web debug Relay on port 18875" >&2
}

if [[ "$#" -ne 1 ]]; then
	usage
	exit 2
fi

profile="$1"
case "$profile" in
debug)
	port="18765"
	;;
simulator)
	port="18767"
	;;
iphone)
	port="18768"
	;;
mobileweb)
	port="18775"
	;;
mobileweb-debug)
	port="18875"
	;;
*)
	usage
	exit 2
	;;
esac

run_dir="$repo_dir/.run/$profile"
pid_file="$run_dir/relay.pid"
log_file="$run_dir/relay.log"
lock_dir="$run_dir/restart.lock"
service_label="com.ai-coding-remote.relay.$profile"
service_target="gui/$(id -u)/$service_label"

mkdir -p "$run_dir"
if ! mkdir "$lock_dir" 2>/dev/null; then
	echo "Relay restart is already in progress." >&2
	exit 1
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

listener_pids() {
	lsof -nP -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
}

resolve_lan_ipv4() {
	local network_interface
	local address

	network_interface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
	if [[ -n "$network_interface" ]]; then
		address="$(ipconfig getifaddr "$network_interface" 2>/dev/null || true)"
		if [[ -n "$address" ]]; then
			echo "$address"
			return 0
		fi
	fi

	address="$(ifconfig 2>/dev/null | awk '$1 == "inet" && $2 !~ /^127\./ && $2 !~ /^169\.254\./ {print $2; exit}')"
	if [[ -n "$address" ]]; then
		echo "$address"
		return 0
	fi

	return 1
}

stop_listeners() {
	local pid
	local pids=()
	while IFS= read -r pid; do
		[[ "$pid" =~ ^[0-9]+$ ]] && pids+=("$pid")
	done < <(listener_pids)

	if [[ "${#pids[@]}" -eq 0 ]]; then
		return
	fi

	echo "Stopping process(es) on port $port: ${pids[*]}"
	kill -TERM "${pids[@]}" 2>/dev/null || true
	for ((attempt = 0; attempt < 50; attempt++)); do
		[[ -z "$(listener_pids)" ]] && return
		sleep 0.1
	done

	pids=()
	while IFS= read -r pid; do
		[[ "$pid" =~ ^[0-9]+$ ]] && pids+=("$pid")
	done < <(listener_pids)
	if [[ "${#pids[@]}" -gt 0 ]]; then
		echo "Force stopping process(es) still using port $port: ${pids[*]}"
		kill -KILL "${pids[@]}" 2>/dev/null || true
	fi
}

managed_pid=""
if launchctl print "$service_target" >/dev/null 2>&1; then
	managed_pid="$(launchctl print "$service_target" 2>/dev/null | awk '/^[[:space:]]*pid = / {print $3; exit}')"
	echo "Stopping managed Relay service: $service_label"
	launchctl remove "$service_label" >/dev/null 2>&1 || true
fi
stop_listeners
if [[ "$managed_pid" =~ ^[0-9]+$ ]] && kill -0 "$managed_pid" 2>/dev/null; then
	for ((attempt = 0; attempt < 50; attempt++)); do
		kill -0 "$managed_pid" 2>/dev/null || break
		sleep 0.1
	done
	if kill -0 "$managed_pid" 2>/dev/null; then
		echo "Force stopping managed Relay process still shutting down: $managed_pid"
		kill -KILL "$managed_pid" 2>/dev/null || true
	fi
	for ((attempt = 0; attempt < 50; attempt++)); do
		kill -0 "$managed_pid" 2>/dev/null || break
		sleep 0.1
	done
	if kill -0 "$managed_pid" 2>/dev/null; then
		echo "Relay process did not exit after SIGKILL; refusing to reuse launchd label $service_label." >&2
		exit 1
	fi
fi
make -C "$repo_dir" build

rm -f "$log_file" "$pid_file"
if [[ "$profile" == "mobileweb" || "$profile" == "mobileweb-debug" ]]; then
	if [[ "$profile" == "mobileweb-debug" ]]; then
		gateway_port="18874"
		auth_control_port="18876"
	else
		gateway_port="18774"
		auth_control_port="18776"
	fi
	launchctl submit \
		-l "$service_label" \
		-o "$log_file" \
		-e "$log_file" \
		-- /usr/bin/env \
		"RUNTIME_ALLOWED_ORIGIN=http://127.0.0.1:$gateway_port" \
		"AUTH_CONTROL_ADDR=127.0.0.1:$auth_control_port" \
		"AUTH_ENABLED=true" \
		"AUTH_COOKIE_SECURE=false" \
		"$repo_dir/bin/relay" --listen "127.0.0.1:$port"
else
	launchctl submit \
		-l "$service_label" \
		-o "$log_file" \
		-e "$log_file" \
		-- /usr/bin/env \
		"AUTH_ENABLED=false" \
		"$repo_dir/bin/relay" --listen ":$port"
fi

for ((attempt = 0; attempt < 50; attempt++)); do
	if curl -fsS "http://127.0.0.1:$port/healthz" >/dev/null 2>&1; then
		relay_pid="$(listener_pids | head -n 1)"
		lan_ipv4="$(resolve_lan_ipv4 || true)"
		echo "$relay_pid" >"$pid_file"
		echo "Relay running: profile=$profile pid=$relay_pid"
		echo "Local HTTP:         http://127.0.0.1:$port"
		echo "Local App WS:       ws://127.0.0.1:$port/ws/app"
		if [[ "$profile" != "mobileweb" && "$profile" != "mobileweb-debug" && -n "$lan_ipv4" ]]; then
			echo "LAN HTTP:           http://$lan_ipv4:$port"
			echo "LAN App WS:         ws://$lan_ipv4:$port/ws/app"
			echo "LAN Agent WS:       ws://$lan_ipv4:$port/ws/agent"
		elif [[ "$profile" != "mobileweb" && "$profile" != "mobileweb-debug" ]]; then
			echo "LAN address:        unavailable"
		else
			if [[ "$profile" == "mobileweb-debug" ]]; then
				echo "LAN entry:          use local Mobile Web Gateway on port 18874"
			else
				echo "LAN entry:          use Mobile Web Gateway on port 18774"
			fi
		fi
		echo "Log: $log_file"
		exit 0
	fi
	if ! launchctl print "$service_target" >/dev/null 2>&1; then
		break
	fi
	sleep 0.1
done

echo "Relay failed to become healthy. Log: $log_file" >&2
tail -n 30 "$log_file" >&2 || true
launchctl remove "$service_label" >/dev/null 2>&1 || true
exit 1
