{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-remote.local/protocol/v2/message.schema.json",
  "title": "AI Coding Remote Message v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "spec_version",
    "message_id",
    "type",
    "occurred_at",
    "trace_id",
    "sender",
    "payload"
  ],
  "properties": {
    "spec_version": { "const": "2.0" },
    "message_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "agent.hello",
        "agent.status",
        "agent.capabilities",
        "execution.profile.list",
        "execution.profile.snapshot",
        "project.list",
        "project.snapshot",
        "thread.list",
        "thread.snapshot",
        "thread.read",
        "thread.detail",
        "source.read",
        "source.snapshot",
        "source.read.failed",
        "turn.start",
        "turn.started",
        "turn.output",
        "turn.item.started",
        "turn.item.delta",
        "turn.item.completed",
        "turn.snapshot",
        "turn.interrupt",
        "turn.interrupted",
        "turn.completed",
        "turn.failed",
        "turn.rejected",
        "turn.acknowledged",
        "bootstrap.start",
        "bootstrap.batch",
        "bootstrap.durable_ack"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 1 },
    "sender": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["user", "device", "relay"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "payload": { "type": "object" }
  }
}
